# Deploy contracts/TenderEscrow.sol to Tempo Moderato, then set its address here.
VITE_TENDER_ESCROW_ADDRESS=
VITE_TENDER_MERCHANT_ADDRESS=
VITE_TENDER_STORE_NAME=
# Optional TIP-20 payment token. Defaults to Tempo pathUSD.
VITE_TEMPO_TOKEN_ADDRESS=0x20c0000000000000000000000000000000000000
VITE_TEMPO_TOKEN_SYMBOL=pathUSD
VITE_REOWN_PROJECT_ID=

# Server-only variables for the shared order API and optional webhook.
DATABASE_URL=
TENDER_ESCROW_ADDRESS=
TENDER_TEMPO_TOKEN_ADDRESS=
# These three are only needed by api/fulfillment.js.
TENDER_WEBHOOK_SECRET=
TENDER_MERCHANT_PRIVATE_KEY=
TENDER_MERCHANT_ADDRESS=
